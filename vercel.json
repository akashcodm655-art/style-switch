{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/hair-services", "destination": "/hair-services.html" },
    { "source": "/styling-service", "destination": "/styling-service.html" },
    { "source": "/color-services", "destination": "/color-services.html" },
    { "source": "/mani-pedi", "destination": "/mani-pedi.html" },
    { "source": "/skincare", "destination": "/skincare.html" },
    { "source": "/massage-body", "destination": "/massage-body.html" },
    { "source": "/waxing-services", "destination": "/waxing-services.html" },
    { "source": "/threading", "destination": "/threading.html" }
  ]
}
